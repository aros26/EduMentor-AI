# EduMentor-AI Environment Variables
# Copy this file to .env and fill in your values

# Required: Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Change this to a long random string in production
SECRET_KEY=change-this-to-a-long-random-secret-key

# Optional: Database URL (default is SQLite)
DATABASE_URL=sqlite:///./edumentor.db

# Optional: Where uploaded files are stored
UPLOAD_DIR=uploads

# Optional: Gemini model name
GEMINI_MODEL=gemini-2.0-flash
